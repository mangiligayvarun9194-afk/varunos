{
  "name": "VarunOS \u2014 30 Telegram Concierge",
  "description": "Single inbound Telegram bot webhook, fanned out by message type. Photo of a meal -> OpenAI vision macros -> POST /v1/logs/meals -> reply. Voice note -> Whisper transcribe -> text->macros -> POST /v1/logs/meals -> reply. Any text -> /v1/coach/act (logs a set/weight/meal from plain English, or answers) (server-side privacy gate) -> reply. Needs OPENAI_API_KEY; set the bot webhook to this URL.",
  "nodes": [
    {
      "parameters": {
        "path": "varunos-telegram",
        "httpMethod": "POST",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "tg-webhook",
      "name": "Telegram webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        220,
        520
      ]
    },
    {
      "parameters": {
        "jsCode": "// One webhook = the bot's single allowed webhook; fan out by message type.\nconst u = $json.body || $json;\nconst m = u.message || u.edited_message || u.channel_post || {};\nconst chat_id = (m.chat && m.chat.id) || '';\nlet route = 'other', file_id = '';\nif (Array.isArray(m.photo) && m.photo.length) {\n  route = 'photo';\n  file_id = m.photo[m.photo.length - 1].file_id; // largest rendition\n} else if (m.voice) {\n  route = 'voice';\n  file_id = m.voice.file_id;\n} else if (m.text) {\n  route = 'text';\n}\nreturn [{ json: { route, chat_id, file_id, text: m.text || '', caption: m.caption || '' } }];\n"
      },
      "id": "classify",
      "name": "Classify update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        520
      ]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{$json.route}}",
        "rules": {
          "rules": [
            {
              "value2": "photo",
              "output": 0
            },
            {
              "value2": "voice",
              "output": 1
            },
            {
              "value2": "text",
              "output": 2
            }
          ]
        },
        "fallbackOutput": 3
      },
