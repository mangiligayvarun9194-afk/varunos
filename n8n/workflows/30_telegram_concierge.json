        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\"food_id\": \"={{$json.food_id}}\", \"portions\": \"={{$json.portions}}\", \"context\": \"={{$json.context}}\", \"kcal\": \"={{$json.kcal}}\", \"p_g\": \"={{$json.p_g}}\", \"c_g\": \"={{$json.c_g}}\", \"f_g\": \"={{$json.f_g}}\"}) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "log-meal",
      "name": "POST /v1/logs/meals",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1820,
        220
      ]
    },
