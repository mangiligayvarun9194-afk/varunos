    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "options": {
          "timeout": 30000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.OPENAI_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\"model\": \"gpt-4o-mini\", \"temperature\": 0, \"max_tokens\": 200, \"response_format\": {\"type\": \"json_object\"}, \"messages\": [{\"role\": \"user\", \"content\": [{\"type\": \"text\", \"text\": \"You are a sports nutritionist. Estimate the nutrition of the food in this photo for the whole plate as served. Reply with ONLY strict JSON, no prose: {\\\"label\\\": short dish name, \\\"kcal\\\": int, \\\"p_g\\\": int, \\\"c_g\\\": int, \\\"f_g\\\": int}. If it is not food return {\\\"label\\\":\\\"not food\\\",\\\"kcal\\\":0,\\\"p_g\\\":0,\\\"c_g\\\":0,\\\"f_g\\\":0}.\"}, {\"type\": \"image_url\", \"image_url\": {\"url\": \"=https://api.telegram.org/file/bot{{$env.TELEGRAM_BOT_TOKEN}}/{{$json.result.file_path}}\"}}]}]}) }}"
      },
      "id": "ph-vision",
      "name": "Vision: meal macros",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1120,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Parse a vision/text model's strict-JSON macro estimate, defending against\n// code fences or stray prose. chat_id carried from the Classify node.\nconst choice = $json.choices && $json.choices[0];\nconst raw = (choice && choice.message && choice.message.content) || '{}';\nlet txt = String(raw).trim().replace(/^```(json)?/i, '').replace(/```$/, '').trim();\nlet o = {};\ntry { o = JSON.parse(txt); } catch (e) {\n  const s = txt.indexOf('{'), ei = txt.lastIndexOf('}');\n  if (s !== -1 && ei !== -1) { try { o = JSON.parse(txt.slice(s, ei + 1)); } catch (_) {} }\n}\nconst num = (v) => { const n = Number(v); return isFinite(n) ? Math.round(n) : 0; };\nconst cls = $node[\"Classify update\"].json;\nreturn [{ json: {\n  food_id: (o.label || 'meal').toString().slice(0, 60),\n  portions: 1,\n  context: cls.caption || (cls.route === 'voice' ? 'voice' : 'photo'),\n  kcal: num(o.kcal), p_g: num(o.p_g), c_g: num(o.c_g), f_g: num(o.f_g),\n  chat_id: cls.chat_id,\n  confident: num(o.kcal) > 0,\n} }];\n"
      },
