{
  "name": "VarunOS \u2014 30 Telegram Concierge",
  "description": "Single inbound Telegram bot webhook. Photo of a meal -> OpenAI vision estimates macros -> POST /v1/logs/meals -> confirmation. Any text -> /v1/coach/ask (server-side privacy gate, tiers only) -> reply. Closes the long-planned Photo Analyzer (#05) and makes the notifier bot two-way. Needs OPENAI_API_KEY; set the bot webhook to this URL.",
  "nodes": [
    {
      "parameters": {
        "path": "varunos-telegram",
        "httpMethod": "POST",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "tg-webhook",
      "name": "Telegram webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        460
      ]
    },
    {
      "parameters": {
        "jsCode": "// Classify an inbound Telegram update into a route + normalized fields.\n// One webhook = the bot's single allowed webhook; we fan out by message type.\nconst u = $json.body || $json;\nconst m = u.message || u.edited_message || u.channel_post || {};\nconst chat_id = (m.chat && m.chat.id) || '';\nlet route = 'other';\nlet file_id = '';\nif (Array.isArray(m.photo) && m.photo.length) {\n  route = 'photo';\n  file_id = m.photo[m.photo.length - 1].file_id; // largest rendition\n} else if (m.text) {\n  route = 'text';\n}\nreturn [{ json: {\n  route,\n  chat_id,\n  file_id,\n  text: m.text || '',\n  caption: m.caption || '',\n} }];\n"
      },
      "id": "classify",
      "name": "Classify update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        460
      ]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{$json.route}}",
        "rules": {
          "rules": [
            {
              "value2": "photo",
              "output": 0
            },
            {
              "value2": "text",
              "output": 1
            }
          ]
        },
        "fallbackOutput": 2
      },
      "id": "router",
      "name": "Route by type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [
        680,
        460
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.telegram.org/bot{{$env.TELEGRAM_BOT_TOKEN}}/getFile?file_id={{$json.file_id}}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "tg-getfile",
      "name": "Telegram getFile",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        920,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.OPENAI_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\"model\": \"gpt-4o-mini\", \"temperature\": 0, \"max_tokens\": 200, \"response_format\": {\"type\": \"json_object\"}, \"messages\": [{\"role\": \"user\", \"content\": [{\"type\": \"text\", \"text\": \"You are a sports nutritionist. Estimate the nutrition of the food in this photo for the whole plate as served. Reply with ONLY a strict JSON object, no prose: {\\\"label\\\": short dish name, \\\"kcal\\\": int, \\\"p_g\\\": int protein grams, \\\"c_g\\\": int carb grams, \\\"f_g\\\": int fat grams}. If it is not food, return {\\\"label\\\":\\\"not food\\\",\\\"kcal\\\":0,\\\"p_g\\\":0,\\\"c_g\\\":0,\\\"f_g\\\":0}.\"}, {\"type\": \"image_url\", \"image_url\": {\"url\": \"=https://api.telegram.org/file/bot{{$env.TELEGRAM_BOT_TOKEN}}/{{$json.result.file_path}}\"}}]}]}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "vision",
      "name": "OpenAI vision",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1160,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Parse the vision model's JSON macro estimate. The model is asked for a\n// strict JSON object; we still defend against code fences / stray prose.\nconst choice = $json.choices && $json.choices[0];\nconst raw = (choice && choice.message && choice.message.content) || '{}';\nlet txt = String(raw).trim().replace(/^```(json)?/i, '').replace(/```$/,'').trim();\nlet obj = {};\ntry { obj = JSON.parse(txt); } catch (e) {\n  const s = txt.indexOf('{'), eIdx = txt.lastIndexOf('}');\n  if (s !== -1 && eIdx !== -1) { try { obj = JSON.parse(txt.slice(s, eIdx + 1)); } catch (_) {} }\n}\nconst num = (v) => { const n = Number(v); return isFinite(n) ? Math.round(n) : 0; };\nconst cls = $node[\"Classify update\"].json;\nreturn [{ json: {\n  food_id: (obj.label || 'meal photo').toString().slice(0, 60),\n  portions: 1,\n  context: cls.caption || 'photo',\n  kcal: num(obj.kcal),\n  p_g: num(obj.p_g),\n  c_g: num(obj.c_g),\n  f_g: num(obj.f_g),\n  chat_id: cls.chat_id,\n  confident: num(obj.kcal) > 0,\n} }];\n"
      },
      "id": "parse-macros",
      "name": "Parse macros",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1380,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.confident}}",
              "value2": true
            }
          ]
        }
      },
      "id": "if-confident",
      "name": "Got macros?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1600,
        300
      ]
    },
