        "method": "POST",
        "url": "=https://api.telegram.org/bot{{$env.TELEGRAM_BOT_TOKEN}}/sendMessage",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "chat_id",
              "value": "={{$node[\"Parse macros\"].json.chat_id}}"
            },
            {
              "name": "text",
              "value": "=Logged \ud83c\udf7d\ufe0f {{$node[\"Parse macros\"].json.food_id}}\\n{{$node[\"Parse macros\"].json.kcal}} kcal \u00b7 P{{$node[\"Parse macros\"].json.p_g}} C{{$node[\"Parse macros\"].json.c_g}} F{{$node[\"Parse macros\"].json.f_g}}\\nToday: {{$json.day_kcal_total}} kcal"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
