{
  "name": "PPL Power",
  "goal": "hypertrophy",
  "split": ["Push", "Pull", "Legs"],
  "days_per_week": 6,
  "weeks": 8,
  "deload_week": 7,
  "progression_rule": "double_progression",
  "days": [
    {
      "name": "Push",
      "exercises": [
        {"id": "bench_press", "sets": 4, "reps": "6-8", "intensity": "RPE 7-8", "rest_s": 180},
        {"id": "ohp", "sets": 3, "reps": "8-10", "intensity": "RPE 7", "rest_s": 150},
        {"id": "incline_db_press", "sets": 3, "reps": "10-12", "intensity": "RPE 8", "rest_s": 90},
        {"id": "lateral_raise", "sets": 4, "reps": "12-15", "intensity": "RPE 9", "rest_s": 60},
        {"id": "tricep_pushdown", "sets": 3, "reps": "12-15", "intensity": "RPE 8", "rest_s": 60},
        {"id": "overhead_tricep_ext", "sets": 3, "reps": "10-12", "intensity": "RPE 8", "rest_s": 60}
      ]
    },
    {
      "name": "Pull",
      "exercises": [
        {"id": "deadlift", "sets": 3, "reps": "5-6", "intensity": "RPE 7", "rest_s": 240},
        {"id": "pullup", "sets": 4, "reps": "6-10", "intensity": "RPE 8", "rest_s": 120},
        {"id": "barbell_row", "sets": 3, "reps": "8-10", "intensity": "RPE 7-8", "rest_s": 120},
        {"id": "seated_row", "sets": 3, "reps": "10-12", "intensity": "RPE 8", "rest_s": 90},
        {"id": "face_pull", "sets": 3, "reps": "12-15", "intensity": "RPE 8", "rest_s": 60},
        {"id": "barbell_curl", "sets": 3, "reps": "10-12", "intensity": "RPE 8", "rest_s": 60},
        {"id": "hammer_curl", "sets": 3, "reps": "10-12", "intensity": "RPE 8", "rest_s": 60}
      ]
    },
    {
      "name": "Legs",
      "exercises": [
        {"id": "squat", "sets": 4, "reps": "6-8", "intensity": "RPE 7-8", "rest_s": 180},
        {"id": "romanian_deadlift", "sets": 3, "reps": "8-10", "intensity": "RPE 7", "rest_s": 150},
        {"id": "leg_press", "sets": 3, "reps": "10-12", "intensity": "RPE 8", "rest_s": 120},
        {"id": "leg_curl", "sets": 3, "reps": "10-12", "intensity": "RPE 8", "rest_s": 90},
        {"id": "leg_extension", "sets": 3, "reps": "12-15", "intensity": "RPE 9", "rest_s": 60},
        {"id": "calf_raise", "sets": 4, "reps": "10-15", "intensity": "RPE 9", "rest_s": 60}
      ]
    }
  ],
  "substitutions": {
    "bench_press": ["db_bench_press", "pushup", "smith_bench"],
    "ohp": ["db_ohp", "arnold_press", "landmine_press"],
    "deadlift": ["romanian_deadlift", "trap_bar_dl", "sumo_dl"],
    "squat": ["front_squat", "goblet_squat", "leg_press", "bulgarian_split_squat"],
    "pullup": ["lat_pulldown", "band_assisted_pullup", "inverted_row"],
    "barbell_row": ["db_row", "chest_supported_row", "seated_row"],
    "barbell_curl": ["db_curl", "preacher_curl", "cable_curl"]
  }
}
