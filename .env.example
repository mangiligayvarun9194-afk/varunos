# VarunOS — required and optional environment variables
# Copy to .env and fill in real values. Never commit .env to source control.

# ====== REQUIRED for any non-local deployment ======

# API key. The PWA sends this in the Authorization: Bearer header.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
VARUNOS_API_KEY=change-me-to-a-long-random-string

# Where the SQLite database lives. Default: ./varunos.db
# For Docker, mount a volume: -v $(pwd)/data:/data
VARUNOS_DB_PATH=/data/varunos.db

# CORS allowlist. Comma-separated origins, or "*" for dev only.
# For a public PWA: https://varunos.example.com
VARUNOS_ALLOWED_ORIGINS=*

# Environment mode: dev | production. Affects startup warnings only.
VARUNOS_ENV=dev

# Single-user MVP. Replace with proper auth later.
VARUNOS_USER_ID=default

# ====== OPTIONAL ======

# Hash salt for API keys at rest. Default is fine for MVP; override for prod.
VARUNOS_KEY_SALT=varunos-default-salt

# Default user profile values (used when no profile is persisted)
# VARUNOS_DEFAULT_NAME=Varun
# VARUNOS_DEFAULT_TZ=America/New_York
